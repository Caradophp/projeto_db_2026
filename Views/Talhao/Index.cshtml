@{
    Layout = "_Layout";
    ViewData["Title"] = "Talhões";
}

<link rel="stylesheet" href="~/css/talhao.css" asp-append-version="true" />

<main class="talhao-page">

    <section class="talhao-hero">
        <div class="talhao-hero-main">
            <div class="talhao-hero-icon">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <div class="talhao-hero-text">
                <span>GESTÃO DA LAVOURA</span>
                <h1>Talhões</h1>
                <p>Organize as áreas de cultivo e acompanhe a distribuição das propriedades.</p>
            </div>
        </div>

        <div class="talhao-hero-decoration">
            <i class="fa-solid fa-wheat-awn"></i>
        </div>
    </section>

    <section class="talhao-stats">

        <article class="talhao-stat-card">
            <span class="talhao-stat-icon green">
                <i class="fa-solid fa-layer-group"></i>
            </span>

            <div>
                <span>Total de talhões</span>
                <strong id="talhaoTotal">0</strong>
                <small>Cadastrados no sistema</small>
            </div>
        </article>

        <article class="talhao-stat-card">
            <span class="talhao-stat-icon green">
                <i class="fa-solid fa-ruler-combined"></i>
            </span>

            <div>
                <span>Área total</span>
                <strong id="talhaoTotalArea">0,00 ha</strong>
                <small>Somando todos os talhões</small>
            </div>
        </article>

        <article class="talhao-stat-card">
            <span class="talhao-stat-icon amber">
                <i class="fa-solid fa-chart-area"></i>
            </span>

            <div>
                <span>Média por talhão</span>
                <strong id="talhaoAverageArea">0,00 ha</strong>
                <small>Área média cadastrada</small>
            </div>
        </article>

        <article class="talhao-stat-card">
            <span class="talhao-stat-icon blue">
                <i class="fa-solid fa-house-chimney"></i>
            </span>

            <div>
                <span>Propriedades vinculadas</span>
                <strong id="talhaoProperties">0</strong>
                <small>Com talhões cadastrados</small>
            </div>
        </article>

    </section>

    <section class="talhao-panel">

        <header class="talhao-panel-header">

            <div>
                <h2>Talhões cadastrados</h2>
                <p>Visualize e gerencie as áreas de cultivo disponíveis.</p>
            </div>

            <div class="talhao-panel-tools">

                <div class="talhao-search">
                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input
                        type="text"
                        id="talhaoSearch"
                        placeholder="Buscar por nome, propriedade ou descrição..."
                        autocomplete="off" />
                </div>

                <button
                    type="button"
                    class="talhao-add-button"
                    id="btnNovoTalhao">

                    <i class="fa-solid fa-plus"></i>
                    Novo talhão
                </button>

            </div>

        </header>

        <div class="talhao-table-wrapper">

            <table class="talhao-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Talhão</th>
                        <th>Área</th>
                        <th>Propriedade</th>
                        <th>Descrição</th>
                        <th class="talhao-actions-heading">Ações</th>
                    </tr>
                </thead>

                <tbody id="talhaoTableBody">

                    <tr>
                        <td colspan="6">

                            <div class="talhao-loading">

                                <span class="talhao-loading-icon">
                                    <i class="fa-solid fa-seedling"></i>
                                </span>

                                <span>Carregando talhões...</span>

                            </div>

                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

        <footer class="talhao-table-footer">
            <span id="talhaoResultsText">
                Nenhum talhão cadastrado
            </span>
        </footer>

    </section>


    <div class="modal fade"
         id="talhaoModal"
         tabindex="-1"
         aria-labelledby="talhaoModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content talhao-modal">

                <div class="modal-header talhao-modal-header">

                    <div class="talhao-modal-title">

                        <span class="talhao-modal-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </span>

                        <div>
                            <h5 id="talhaoModalLabel">
                                Novo talhão
                            </h5>

                            <p>
                                Cadastre ou atualize uma área de cultivo.
                            </p>
                        </div>

                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                    </button>

                </div>

                <form id="talhaoForm">

                    <div class="modal-body talhao-modal-body">

                        <input
                            type="hidden"
                            id="talhaoId"
                            value="0" />

                        <div class="talhao-modal-grid">

                            <div class="talhao-form-group">

                                <label for="talNome">
                                    Nome do talhão
                                    <span>*</span>
                                </label>

                                <div class="talhao-input">
                                    <i class="fa-solid fa-layer-group"></i>

                                    <input
                                        type="text"
                                        id="talNome"
                                        placeholder="Ex.: Talhão Norte"
                                        required />
                                </div>

                            </div>

                            <div class="talhao-form-group">

                                <label for="talArea">
                                    Área (ha)
                                    <span>*</span>
                                </label>

                                <div class="talhao-input">

                                    <i class="fa-solid fa-ruler-combined"></i>

                                    <input
                                        type="number"
                                        id="talArea"
                                        step="0.01"
                                        min="0"
                                        placeholder="0,00"
                                        required />

                                    <span class="talhao-input-suffix">
                                        ha
                                    </span>

                                </div>

                            </div>

                            <div class="talhao-form-group">

                                <label for="talProp">
                                    Propriedade
                                    <span>*</span>
                                </label>

                                <div class="talhao-input">

                                    <i class="fa-solid fa-house-chimney"></i>

                                    <select
                                        id="talProp"
                                        required>

                                        <option value="">
                                            Selecione uma propriedade...
                                        </option>

                                    </select>

                                </div>

                            </div>

                            <div class="talhao-form-group talhao-description-group">

                                <label for="talDesc">
                                    Descrição
                                </label>

                                <div class="talhao-textarea">

                                    <textarea
                                        id="talDesc"
                                        rows="3"
                                        maxlength="500"
                                        placeholder="Informações adicionais sobre o talhão..."></textarea>

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="talhao-modal-footer">

                        <button
                            type="button"
                            class="talhao-button-secondary"
                            data-bs-dismiss="modal">

                            Cancelar
                        </button>

                        <button
                            type="submit"
                            class="talhao-button-primary">

                            <i class="fa-solid fa-check"></i>
                            Salvar talhão
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</main>

<script src="~/js/talhao.js" asp-append-version="true"></script>