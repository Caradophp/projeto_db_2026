@{
    Layout = null;
    ViewData["Title"] = "Recuperar senha";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Recuperar senha | Banco Dados</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet"
          href="~/css/forgot-password.css"
          asp-append-version="true" />
</head>

<body>

    <div class="loader visually-hidden" id="loader">
        <img src="~/img/agriculture_loading.gif" alt="Carregando" />
        <span>Carregando...</span>
    </div>

    <main class="recovery-page">

        <section class="recovery-card">

            <div class="recovery-content">

                <!-- ETAPA 1: E-MAIL -->
                <div class="mainForm">

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="back-login">
                        <span aria-hidden="true">&larr;</span>
                        Voltar para o login
                    </a>

                    <div class="recovery-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24">
                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="10"
                                  rx="2">
                            </rect>

                            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>

                            <circle cx="12"
                                    cy="15"
                                    r="1.2">
                            </circle>
                        </svg>
                    </div>

                    <div class="recovery-heading">

                        <span class="recovery-eyebrow">
                            Recuperação de acesso
                        </span>

                        <h1>Recupere sua senha</h1>

                        <p>
                            Informe o e-mail cadastrado na sua conta.
                            Enviaremos um código para você continuar
                            a recuperação.
                        </p>

                    </div>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>

                    <div class="alert alert-danger visually-hidden"
                         role="alert">
                    </div>

                    <div class="recovery-field">

                        <label for="email" class="form-label">
                            E-mail
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3"
                                          y="5"
                                          width="18"
                                          height="14"
                                          rx="2">
                                    </rect>

                                    <path d="m4 7 8 6 8-6"></path>
                                </svg>
                            </span>

                            <input id="email"
                                   type="email"
                                   class="form-control"
                                   placeholder="seu@email.com"
                                   name="email"
                                   autocomplete="email"
                                   required
                                   autofocus />

                        </div>

                    </div>

                    <button type="button"
                            class="recovery-button"
                            id="sendEmailBtn">

                        <span>Enviar código</span>

                        <span class="button-arrow"
                              aria-hidden="true">
                            &rarr;
                        </span>

                    </button>

                    <p class="signup-text">
                        Ainda não possui uma conta?

                        <a asp-controller="User"
                           asp-action="Index">
                            Cadastre-se
                        </a>
                    </p>

                </div>


                <!-- ETAPA 2: CÓDIGO -->
                <div class="visually-hidden"
                     id="codeForm">

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="back-login">
                        <span aria-hidden="true">&larr;</span>
                        Voltar para o login
                    </a>

                    <div class="recovery-icon code-icon"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24">
                            <rect x="3"
                                  y="5"
                                  width="18"
                                  height="14"
                                  rx="2">
                            </rect>

                            <path d="m4 7 8 6 8-6"></path>

                            <path d="M17 16h4"></path>
                            <path d="M19 14v4"></path>
                        </svg>

                    </div>

                    <div class="recovery-heading">

                        <span class="recovery-eyebrow">
                            Verificação
                        </span>

                        <h1>Verifique seu e-mail</h1>

                        <p>
                            Enviamos um código de 6 dígitos.
                            Digite-o abaixo para continuar.
                        </p>

                    </div>

                    <div class="recovery-field">

                        <label for="codigo"
                               class="form-label">
                            Código de recuperação
                        </label>

                        <input id="codigo"
                               type="text"
                               inputmode="numeric"
                               maxlength="6"
                               class="form-control code-input"
                               placeholder="000000"
                               name="codigo"
                               autocomplete="one-time-code"
                               required />

                    </div>

                    <button type="button"
                            class="recovery-button"
                            id="checkCodeBtn">

                        <span>Verificar código</span>

                        <span class="button-arrow"
                              aria-hidden="true">
                            &rarr;
                        </span>

                    </button>

                </div>


                <!-- ETAPA 3: NOVA SENHA -->
                <div class="visually-hidden"
                     id="newPasswordForm">

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="back-login">
                        <span aria-hidden="true">&larr;</span>
                        Voltar para o login
                    </a>

                    <div class="recovery-icon password-icon"
                         aria-hidden="true">

                        <svg viewBox="0 0 24 24">

                            <rect x="5"
                                  y="10"
                                  width="14"
                                  height="10"
                                  rx="2">
                            </rect>

                            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>

                            <path d="M12 14v3"></path>

                        </svg>

                    </div>

                    <div class="recovery-heading">

                        <span class="recovery-eyebrow">
                            Nova senha
                        </span>

                        <h1>Crie sua nova senha</h1>

                        <p>
                            Escolha uma nova senha para acessar
                            sua conta novamente.
                        </p>

                    </div>

                    <div class="recovery-field">

                        <label for="newPassword"
                               class="form-label">
                            Nova senha
                        </label>

                        <input id="newPassword"
                               type="password"
                               class="form-control"
                               placeholder="Digite sua nova senha"
                               autocomplete="new-password"
                               required />

                    </div>

                    <div class="recovery-field">

                        <label for="confirmNewPassword"
                               class="form-label">
                            Confirmar nova senha
                        </label>

                        <input id="confirmNewPassword"
                               type="password"
                               class="form-control"
                               placeholder="Digite a senha novamente"
                               autocomplete="new-password"
                               required />

                    </div>

                    <button type="button"
                            class="recovery-button"
                            id="changePasswordBtn">

                        <span>Alterar senha</span>

                        <span class="button-arrow"
                              aria-hidden="true">
                            &rarr;
                        </span>

                    </button>

                </div>

            </div>


            <!-- PAINEL VISUAL -->
            <aside class="recovery-visual">

                <div class="visual-overlay"></div>

                <div class="visual-brand">
                    BANCO DADOS
                </div>

                <div class="visual-content">

                    <span class="visual-badge">
                        Acesso seguro
                    </span>

                    <h2>
                        Sua conta,<br />
                        protegida.
                    </h2>

                    <p>
                        Recupere seu acesso de forma simples
                        e volte a cuidar da sua gestão agrícola.
                    </p>

                </div>

            </aside>

        </section>

    </main>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>

</body>
</html>