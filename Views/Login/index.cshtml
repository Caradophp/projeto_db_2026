@{
    Layout = null;
    ViewData["Title"] = "Login Page";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Entrar | Banco Dados</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>
    <div class="loader visually-hidden" id="loader">
        <img src="~/img/agriculture_loading.gif" alt="Carregando" />
        <span>Carregando...</span>
    </div>

    <main class="login-page d-flex align-items-center justify-content-center">
        <div class="login-card row g-0">

            <div class="login-intro col-md-5">
                <div class="brand">BANCO DADOS</div>

                <div>
                    <h2 class="fw-bold mb-3">Bem-vindo de volta!</h2>
                    <p class="mb-0 opacity-75">
                        Acesse sua conta de forma simples, rápida e segura.
                    </p>
                </div>
            </div>

            <form class="login-form col-md-7" method="post">

                <div class="mb-4">
                    <h1 class="mb-2">Entrar</h1>

                    <p class="subtitle mb-0 p1">
                        Informe seus dados para continuar.
                    </p>

                    <p class="subtitle mb-0 visually-hidden p2">
                        Informe sua nova senha para continuar.
                    </p>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="alert alert-danger visually-hidden"></div>

                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>

                    <input id="email"
                           type="email"
                           class="form-control"
                           placeholder="seu@email.com"
                           name="email"
                           autocomplete="email"
                           required />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Senha</label>
                    <div class="password-field">
                        <input id="password"
                               type="password"
                               class="form-control"
                               placeholder="Digite sua senha"
                               name="password"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Mostrar senha"
                                title="Mostrar senha">

                            <span class="password-icon"
                                  id="passwordIcon"
                                  aria-hidden="true">◉</span>
                        </button>
                    </div>
                </div>

                <div class="mb-3 visually-hidden" id="newPassForm">
                    <label for="confirmPassword" class="form-label">
                        Confirme sua Senha
                    </label>

                    <input id="confirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Digite sua senha"
                           name="confirmPassword"
                           required />
                </div>

                <div class="d-flex justify-content-end mb-4">
                    <a href="/login/forgotpassword"
                       class="small text-decoration-none">
                        Esqueceu sua senha?
                    </a>
                </div>

                <button type="button"
                        class="btn btn-primary btn-login w-100"
                        id="enterBtn">
                    Entrar
                </button>

                <button type="button"
                        class="btn btn-primary btn-login w-100 visually-hidden"
                        id="newPassBtn">
                    Confirmar
                </button>

                <p class="text-center text-muted small mt-4 mb-0 p1">
                    Não é usuário?

                    <a asp-controller="User"
                       asp-action="Index"
                       class="fw-semibold text-decoration-none">
                        Cadastre-se
                    </a>
                </p>

            </form>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>