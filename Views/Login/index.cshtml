@{
    Layout = null;
    ViewData["Title"] = "Login Page";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar | Banco Dados</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root { --ink: #173229; --muted: #6b7f75; --primary: #2f7d4a; }
        body { min-height: 100vh; margin: 0; color: var(--ink); font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f2f8f2; }
        .login-page { min-height: 100vh; padding: 2rem 1rem; background: radial-gradient(circle at 10% 10%, #a8d5a8 0, transparent 32%), linear-gradient(135deg, #edf7ed 0%, #f9fcf8 100%); }
        .login-card { width: min(100%, 920px); min-height: 560px; overflow: hidden; border: 0; border-radius: 24px; background: #fff; box-shadow: 0 24px 70px rgba(39, 82, 52, .16); }
        .login-intro { position: relative; display: flex; flex-direction: column; justify-content: space-between; padding: 3rem; color: #fff; background: linear-gradient(145deg, #23633d, #4d995b); }
        .login-intro::after { content: ""; position: absolute; width: 220px; height: 220px; right: -75px; bottom: -75px; border: 35px solid rgba(255,255,255,.12); border-radius: 50%; }
        .brand { font-size: 1.15rem; font-weight: 700; letter-spacing: .04em; }
        .login-form { display: flex; flex-direction: column; justify-content: center; padding: 3rem; }
        .login-form h1 { font-size: 2rem; font-weight: 700; }
        .subtitle { color: var(--muted); }
        .form-label { font-size: .9rem; font-weight: 600; }
        .form-control { padding: .8rem 1rem; border: 1px solid #e1e5f0; border-radius: 10px; }
        .form-control:focus { border-color: var(--primary); box-shadow: 0 0 0 .2rem rgba(47,125,74,.15); }
        .btn-login { padding: .8rem; border: 0; border-radius: 10px; background: var(--primary); }
        .btn-login:hover { background: #25643b; }
        @* @media (max-width: 767px) { .login-intro { min-height: 210px; padding: 2rem; } .login-form { padding: 2rem 1.5rem; } } *@
    </style>
</head>
<body>
    <main class="login-page d-flex align-items-center justify-content-center">
        <div class="login-card row g-0">
            <div class="login-intro col-md-5">
                <div class="brand">BANCO DADOS</div>
                <div>
                    <h2 class="fw-bold mb-3">Bem-vindo de volta!</h2>
                    <p class="mb-0 opacity-75">Acesse sua conta de forma simples, rápida e segura.</p>
                </div>
            </div>  
            <form class="login-form col-md-7" asp-controller="Login" asp-action="CheckUserLogin" method="post">
                <div class="mb-4">
                    <h1 class="mb-2">Entrar</h1>
                    <p class="subtitle mb-0">Informe seus dados para continuar.</p>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input id="email" type="email" class="form-control" placeholder="seu@email.com" name="email" autocomplete="email" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Senha</label>
                    <input id="password" type="password" class="form-control" placeholder="Digite sua senha" name="password" autocomplete="current-password" required>
                </div>
                <div class="d-flex justify-content-end mb-4">
                    <a href="/login/forgotpassword" class="small text-decoration-none">Esqueceu sua senha?</a>
                </div>
                <button type="submit" class="btn btn-primary btn-login w-100">Entrar</button>
                <p class="text-center text-muted small mt-4 mb-0">Não é usuário? <a asp-controller="User" asp-action="Index" class="fw-semibold text-decoration-none">Cadastre-se</a></p>
            </form>
        </div>
    </main>
</body>
</html>