@{
    Layout = null;
    ViewData["Title"] = "Login Page";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Entrar | Banco Dados</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>

    <div class="loader visually-hidden" id="loader">
        <img src="~/img/agriculture_loading.gif" alt="Carregando" />
        <span>Carregando...</span>
    </div>

    <main class="login-page">

        <section class="login-card">

            <!-- PAINEL COM IMAGEM -->
            <div class="login-visual">

                <div class="login-visual-overlay"></div>

                <div class="login-brand">
                    BANCO DADOS
                </div>

                <div class="login-welcome">
                    <h2>Bem-vindo de volta!</h2>

                    <p>
                        Acesse sua conta de forma simples,
                        rápida e segura.
                    </p>
                </div>

            </div>

            <!-- FORMULÁRIO -->
            <div class="login-content">

                <form class="login-form" method="post">

                    <div class="login-heading">
                        <h1>Entrar</h1>

                        <p class="subtitle p1">
                            Informe seus dados para continuar.
                        </p>

                        <p class="subtitle p2 visually-hidden">
                            Informe sua nova senha para continuar.
                        </p>
                    </div>

                    <div
                        asp-validation-summary="ModelOnly"
                        class="text-danger">
                    </div>

                    <div
                        class="alert alert-danger visually-hidden"
                        role="alert">
                    </div>

                    <!-- EMAIL -->
                    <div class="login-field">

                        <label for="email" class="form-label">
                            E-mail
                        </label>

                        <input
                            id="email"
                            type="email"
                            class="form-control"
                            placeholder="seu@email.com"
                            name="email"
                            autocomplete="email"
                            required />

                    </div>

                    <!-- SENHA -->
                    <div class="login-field">

                        <label for="password" class="form-label">
                            Senha
                        </label>

                        <div class="password-field">

                            <input
                                id="password"
                                type="password"
                                class="form-control"
                                placeholder="Digite sua senha"
                                name="password"
                                autocomplete="current-password"
                                required />

                            <button
                                type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Mostrar senha"
                                title="Mostrar senha">

                                <span
                                    id="passwordIcon"
                                    aria-hidden="true">
                                    ◉
                                </span>

                            </button>

                        </div>

                    </div>

                    <!-- CONFIRMAR NOVA SENHA -->
                    <div
                        class="login-field visually-hidden"
                        id="newPassForm">

                        <label
                            for="confirmPassword"
                            class="form-label">

                            Confirme sua senha

                        </label>

                        <input
                            id="confirmPassword"
                            type="password"
                            class="form-control"
                            placeholder="Digite sua senha novamente"
                            name="confirmPassword" />

                    </div>

                    <!-- ESQUECI A SENHA -->
                    <div class="forgot-password p1">

                        <a href="/login/forgotpassword">
                            Esqueceu sua senha?
                        </a>

                    </div>

                    <!-- BOTÃO LOGIN -->
                    <button
                        type="button"
                        class="btn-login"
                        id="enterBtn">

                        Entrar

                    </button>

                    <!-- BOTÃO NOVA SENHA -->
                    <button
                        type="button"
                        class="btn-login visually-hidden"
                        id="newPassBtn">

                        Confirmar

                    </button>

                    <!-- CADASTRO -->
                    <p class="signup-text p1">

                        Não é usuário?

                        <a
                            asp-controller="User"
                            asp-action="Index">

                            Cadastre-se

                        </a>

                    </p>

                </form>

            </div>

        </section>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/utils.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>

</body>
</html>