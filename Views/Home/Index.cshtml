@{
    ViewData["Title"] = "Início";
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<main class="home-dashboard">

    <!-- HERO / BANNER -->
    <section class="home-hero">
        <div class="home-hero-overlay"></div>

        <div class="home-hero-content">
            <div class="home-hero-eyebrow">
                <i class="fa-solid fa-leaf"></i>
                <span>BEM-VINDO AO CAMPO</span>
            </div>

            <h1>Cultiva<span>#</span></h1>
            <p>Gestão inteligente para o seu campo.</p>
        </div>
    </section>

    <!-- RESUMO -->
    <section class="dashboard-section">
        <div class="section-title">
            <h2>Resumo da produção</h2>
            <p>Informações atualizadas a partir dos registros do sistema.</p>
        </div>

        <div class="stats-grid">

            <!-- PROPRIEDADES -->
            <a asp-controller="Gestao"
               asp-action="Propriedades"
               class="stat-card stat-card-green">

                <div class="stat-icon-circle">
                    <i class="fa-solid fa-house-chimney"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">Propriedades</span>

                    <strong class="stat-value" id="stat-propriedade">
                        <span class="loading-value"></span>
                    </strong>

                    <span class="stat-description">Total cadastrado</span>
                </div>

                <span class="stat-arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>

                <div class="stat-decoration"></div>
            </a>

            <!-- TALHÕES -->
            <a asp-controller="Gestao"
               asp-action="Talhoes"
               class="stat-card stat-card-yellow">

                <div class="stat-icon-circle">
                    <i class="fa-solid fa-table-cells-large"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">Talhões</span>

                    <strong class="stat-value" id="stat-talhao">
                        <span class="loading-value"></span>
                    </strong>

                    <span class="stat-description">Total cadastrado</span>
                </div>

                <span class="stat-arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>

                <div class="stat-decoration"></div>
            </a>

            <!-- CULTURAS -->
            <a asp-controller="Gestao"
               asp-action="Culturas"
               class="stat-card stat-card-green">

                <div class="stat-icon-circle">
                    <i class="fa-solid fa-leaf"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">Culturas</span>

                    <strong class="stat-value" id="stat-cultura">
                        <span class="loading-value"></span>
                    </strong>

                    <span class="stat-description">Total cadastrado</span>
                </div>

                <span class="stat-arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>

                <div class="stat-decoration"></div>
            </a>

            <!-- PLANTIOS -->
            <a asp-controller="Gestao"
               asp-action="Plantios"
               class="stat-card stat-card-blue">

                <div class="stat-icon-circle">
                    <i class="fa-solid fa-seedling"></i>
                </div>

                <div class="stat-content">
                    <span class="stat-label">Plantios</span>

                    <strong class="stat-value" id="stat-plantio">
                        <span class="loading-value"></span>
                    </strong>

                    <span class="stat-description">Total cadastrado</span>
                </div>

                <span class="stat-arrow">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>

                <div class="stat-decoration"></div>
            </a>

        </div>
    </section>

    <!-- CONTEÚDO -->
    <section class="dashboard-content-grid">

        <!-- REGISTROS -->
        <article class="dashboard-panel">
            <div class="dashboard-panel-header">
                <h3>Registros do sistema</h3>
                <p>Quantidade de informações cadastradas por categoria.</p>
            </div>

            <div class="table-wrapper" style="overflow-y: scroll;">
                <table class="dashboard-table">
                    <thead>
                        <tr>
                            <th>Tabela</th>
                            <th>Quantidade de registros</th>
                        </tr>
                    </thead>

                    <tbody id="tbody-tables-info">
                        <tr>
                            <td colspan="2">
                                Carregando informações...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </article>

        <!-- COLUNA LATERAL -->
        <div class="dashboard-side-column">

            <!-- ACESSO RÁPIDO -->
            <aside class="dashboard-panel quick-access-panel">
                <div class="dashboard-panel-header panel-title-with-icon">
                    <div class="panel-title-icon">
                        <i class="fa-solid fa-bolt"></i>
                    </div>

                    <div>
                        <h3>Acesso rápido</h3>
                        <p>Acesse as principais funcionalidades do sistema.</p>
                    </div>
                </div>

                <div class="quick-access-grid">

                    <a asp-controller="Gestao"
                       asp-action="Propriedades"
                       class="quick-access-item quick-green">
                        <span class="quick-access-icon">
                            <i class="fa-solid fa-house-chimney"></i>
                        </span>
                        <span>Nova Propriedade</span>
                        <i class="fa-solid fa-chevron-right quick-access-arrow"></i>
                    </a>

                    <a asp-controller="Gestao"
                       asp-action="Talhoes"
                       class="quick-access-item quick-yellow">
                        <span class="quick-access-icon">
                            <i class="fa-solid fa-table-cells-large"></i>
                        </span>
                        <span>Novo Talhão</span>
                        <i class="fa-solid fa-chevron-right quick-access-arrow"></i>
                    </a>

                    <a asp-controller="Gestao"
                       asp-action="Culturas"
                       class="quick-access-item quick-green">
                        <span class="quick-access-icon">
                            <i class="fa-solid fa-leaf"></i>
                        </span>
                        <span>Nova Cultura</span>
                        <i class="fa-solid fa-chevron-right quick-access-arrow"></i>
                    </a>

                    <a asp-controller="Gestao"
                       asp-action="Plantios"
                       class="quick-access-item quick-blue">
                        <span class="quick-access-icon">
                            <i class="fa-solid fa-seedling"></i>
                        </span>
                        <span>Novo Plantio</span>
                        <i class="fa-solid fa-chevron-right quick-access-arrow"></i>
                    </a>

                    <a asp-controller="Colheita"
                       asp-action="Index"
                       class="quick-access-item quick-yellow">
                        <span class="quick-access-icon">
                            <i class="fa-solid fa-wheat-awn"></i>
                        </span>
                        <span>Registrar Colheita</span>
                        <i class="fa-solid fa-chevron-right quick-access-arrow"></i>
                    </a>

                    <a asp-controller="Gestao"
                       asp-action="Insumos"
                       class="quick-access-item quick-blue">
                        <span class="quick-access-icon">
                            <i class="fa-solid fa-flask"></i>
                        </span>
                        <span>Novo Insumo</span>
                        <i class="fa-solid fa-chevron-right quick-access-arrow"></i>
                    </a>

                    <a asp-controller="Gestao"
                       asp-action="Aplicacoes"
                       class="quick-access-item quick-blue quick-access-wide">
                        <span class="quick-access-icon">
                            <i class="fa-solid fa-tractor"></i>
                        </span>
                        <span>Registrar Aplicação</span>
                        <i class="fa-solid fa-chevron-right quick-access-arrow"></i>
                    </a>

                </div>
            </aside>

            <!-- SOBRE -->
            <aside class="dashboard-panel about-panel">
                <div class="about-icon">
                    <i class="fa-solid fa-circle-info"></i>
                </div>

                <div class="about-content">
                    <h3>Sobre o sistema</h3>

                    <p>
                        O Cultiva# é um sistema de gestão agrícola desenvolvido
                        para auxiliar no controle das propriedades, talhões,
                        culturas e operações, facilitando o acompanhamento da
                        produção.
                    </p>
                </div>

                <div class="about-decoration">
                    <i class="fa-solid fa-seedling"></i>
                </div>
            </aside>
            <!-- EQUIPE -->
            <aside class="dashboard-panel team-panel">
                <div class="dashboard-panel-header panel-title-with-icon">
                    <div class="panel-title-icon team-title-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <div>
                        <h3>Equipe de desenvolvimento</h3>
                        <p>Integrantes responsáveis pelo desenvolvimento do Cultiva#.</p>
                    </div>
                </div>

                <div class="team-members">
    <div class="team-member">
        <span class="team-member-icon member-brown">
            <i class="fa-solid fa-user"></i>
        </span>
        <span>Eloísa Jahring</span>
    </div>

    <div class="team-member">
        <span class="team-member-icon member-blue">
            <i class="fa-solid fa-user"></i>
        </span>
        <span>Luciano Friebe Feigl</span>
    </div>

    <div class="team-member">
        <span class="team-member-icon member-green">
            <i class="fa-solid fa-user"></i>
        </span>
        <span>Miguel Batista de Sousa Borges</span>
    </div>

    <div class="team-member">
        <span class="team-member-icon member-yellow">
            <i class="fa-solid fa-user"></i>
        </span>
        <span>Rhaique Ribeth Moreira</span>
    </div>

    <div class="team-member">
        <span class="team-member-icon member-pink">
            <i class="fa-solid fa-user"></i>
        </span>
        <span>Yasmim Marques Jardim</span>
    </div>
</div>
            </aside>

        </div>

    </section>

</main>