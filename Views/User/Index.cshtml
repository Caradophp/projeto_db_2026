@{
    Layout = null;
    ViewData["Title"] = "Criar conta";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Criar conta | Banco Dados</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/signup.css" asp-append-version="true" />
</head>

<body>

    <div class="loader visually-hidden" id="loader">
        <img src="~/img/agriculture_loading.gif" alt="Carregando" />
        <span>Carregando...</span>
    </div>

    <main class="signup-page">

        <section class="signup-card">

            <div class="signup-visual">

                <div class="signup-visual-overlay"></div>

                <div class="signup-brand">
                    BANCO DADOS
                </div>

                <div class="signup-welcome">
                    <h2>Faça parte da nossa comunidade</h2>

                    <p>
                        Crie sua conta e tenha acesso a uma experiência
                        simples, rápida e segura.
                    </p>
                </div>

            </div>

            <div class="signup-content">

                <form class="signup-form" method="post">

                    <div class="signup-heading">
                        <h1>Criar conta</h1>

                        <p class="signup-subtitle">
                            Preencha seus dados para começar.
                        </p>
                    </div>

                    <div
                        asp-validation-summary="ModelOnly"
                        class="text-danger">
                    </div>

                    <div
                        class="alert alert-danger visually-hidden"
                        role="alert">
                    </div>

                    <div class="signup-field">
                        <label for="name" class="form-label">
                            Nome
                        </label>

                        <input
                            id="name"
                            type="text"
                            class="form-control"
                            placeholder="Seu nome completo"
                            name="name"
                            autocomplete="name"
                            required
                            autofocus />
                    </div>

                    <div class="signup-field">
                        <label for="email" class="form-label">
                            E-mail
                        </label>

                        <input
                            id="email"
                            type="email"
                            class="form-control"
                            placeholder="seu@email.com"
                            name="email"
                            autocomplete="email"
                            required />
                    </div>

                    <div class="signup-field">
                        <label for="password" class="form-label">
                            Senha
                        </label>

                        <div class="password-field">

                            <input
                                id="password"
                                type="password"
                                class="form-control"
                                placeholder="Digite sua senha"
                                name="password"
                                autocomplete="new-password"
                                minlength="6"
                                required />

                            <button
                                type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Mostrar senha"
                                title="Mostrar senha">

                                <span
                                    id="passwordIcon"
                                    aria-hidden="true">
                                    ◉
                                </span>

                            </button>

                        </div>
                    </div>

                    <div class="signup-field">
                        <label for="confirmPassword" class="form-label">
                            Confirmar senha
                        </label>

                        <div class="password-field">

                            <input
                                id="confirmPassword"
                                type="password"
                                class="form-control"
                                placeholder="Digite sua senha novamente"
                                name="confirmPassword"
                                autocomplete="new-password"
                                minlength="6"
                                required />

                            <button
                                type="button"
                                class="password-toggle"
                                id="toggleConfirmPassword"
                                aria-label="Mostrar confirmação da senha"
                                title="Mostrar senha">

                                <span
                                    id="confirmPasswordIcon"
                                    aria-hidden="true">
                                    ◉
                                </span>

                            </button>

                        </div>
                    </div>

                    <button
                        type="button"
                        class="btn-signup"
                        id="singupBtn">

                        Criar minha conta

                    </button>

                    <p class="login-text">
                        Já tem uma conta?

                        <a
                            asp-controller="Login"
                            asp-action="Index">
                            Voltar para o login
                        </a>
                    </p>

                </form>

            </div>

        </section>

    </main>

   <script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/utils.js"></script>
<script src="~/js/signup.js" asp-append-version="true"></script>
</body>
</html>